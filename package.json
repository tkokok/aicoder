{
  "name": "aicoder",
  "version": "2.2.3",
  "description": "AICoder MVP - AI-powered coding agent",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc && cp frontend/*.html frontend/*.css dist/frontend/ 2>/dev/null || true",
    "build:release": "rm -rf dist && tsc -p tsconfig.release.json && cp frontend/*.html frontend/*.css dist/frontend/ 2>/dev/null || true",
    "start": "bun dist/server/index.js",
    "test": "bun test tests/e2e-integration.test.ts",
    "lint": "echo \"No linter yet\" && exit 0"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.0.0",
    "better-sqlite3": "^11.7.0",
    "eventsource": "^4.1.0",
    "fastify": "^5.2.0",
    "js-yaml": "^4.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "bun-types": "^1.0.0",
    "typescript": "^5.7.0"
  }
}
